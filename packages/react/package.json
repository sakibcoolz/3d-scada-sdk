{
  "name": "@sakibcoolz/react",
  "version": "0.1.1",
  "description": "React viewer and editor for 3D SCADA SDK scenes, built on three.js and React Three Fiber.",
  "license": "MIT",
  "author": "sakibcoolz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakibcoolz/3d-scada-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/sakibcoolz/3d-scada-sdk#readme",
  "bugs": {
    "url": "https://github.com/sakibcoolz/3d-scada-sdk/issues"
  },
  "keywords": [
    "scada",
    "3d",
    "threejs",
    "industrial",
    "digital-twin",
    "react",
    "react-three-fiber",
    "editor",
    "viewer"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sakibcoolz/asset-import": "workspace:*",
    "@sakibcoolz/components": "workspace:*",
    "@sakibcoolz/core": "workspace:*",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "@types/three": "^0.175.0",
    "three": "^0.175.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "exports": {
    ".": "./src/index.tsx"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js"
  }
}
