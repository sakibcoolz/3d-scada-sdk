{
  "name": "@sakibcoolz/simulation",
  "version": "0.2.0",
  "description": "Optional deterministic mass-balance simulation for @scada3d scenes; results are always SIMULATED.",
  "license": "MIT",
  "author": "sakibcoolz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakibcoolz/3d-scada-sdk.git",
    "directory": "packages/simulation"
  },
  "homepage": "https://github.com/sakibcoolz/3d-scada-sdk#readme",
  "bugs": {
    "url": "https://github.com/sakibcoolz/3d-scada-sdk/issues"
  },
  "keywords": [
    "scada",
    "3d",
    "threejs",
    "industrial",
    "digital-twin",
    "simulation",
    "hydraulics",
    "mass-balance"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sakibcoolz/core": "workspace:*",
    "@sakibcoolz/components": "workspace:*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js"
  }
}
