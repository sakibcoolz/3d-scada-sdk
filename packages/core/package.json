{
  "name": "@scada3d/core",
  "version": "0.1.0",
  "description": "Framework-neutral scene model, port graph, validation and routing for 3D SCADA scenes.",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js"
  }
}
