{
  "name": "@sakibcoolz/core",
  "version": "0.2.0",
  "description": "Framework-neutral scene model, port graph, validation and routing for 3D SCADA scenes.",
  "license": "MIT",
  "author": "sakibcoolz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakibcoolz/3d-scada-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://sakibcoolz.github.io/3d-scada-sdk/",
  "bugs": {
    "url": "https://github.com/sakibcoolz/3d-scada-sdk/issues"
  },
  "keywords": [
    "scada",
    "3d",
    "threejs",
    "industrial",
    "digital-twin",
    "scene-graph",
    "port-graph",
    "routing"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "schema",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./schema/*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./schema/*": "./schema/*"
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js"
  }
}
