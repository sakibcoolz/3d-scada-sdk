{
  "name": "@sakibcoolz/asset-import",
  "version": "0.1.1",
  "description": "Optional allow-list SVG sanitizer and shape model for the 3D SCADA SDK (no DOM dependency).",
  "license": "MIT",
  "author": "sakibcoolz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakibcoolz/3d-scada-sdk.git",
    "directory": "packages/asset-import"
  },
  "homepage": "https://github.com/sakibcoolz/3d-scada-sdk#readme",
  "bugs": {
    "url": "https://github.com/sakibcoolz/3d-scada-sdk/issues"
  },
  "keywords": [
    "scada",
    "3d",
    "threejs",
    "industrial",
    "digital-twin",
    "svg",
    "sanitizer"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js"
  }
}
