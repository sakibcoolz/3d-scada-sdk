{
  "name": "@scada3d/components",
  "version": "0.1.0",
  "description": "Industrial component catalog (tank, pipe, valve, fittings) for @scada3d/core.",
  "license": "MIT",
  "author": "sakibcoolz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakibcoolz/3d-scada-sdk.git",
    "directory": "packages/components"
  },
  "homepage": "https://github.com/sakibcoolz/3d-scada-sdk#readme",
  "bugs": {
    "url": "https://github.com/sakibcoolz/3d-scada-sdk/issues"
  },
  "keywords": [
    "scada",
    "3d",
    "threejs",
    "industrial",
    "digital-twin",
    "industrial-components",
    "asme",
    "procedural-geometry"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@scada3d/core": "workspace:*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js"
  }
}
