{
  "name": "3d-scada-sdk",
  "private": true,
  "version": "0.1.2",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @sakibcoolz/playground dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench": "vitest bench --run",
    "perf": "playwright test --config playwright.perf.config.ts",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "test:consumer": "playwright test --config playwright.consumer.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
